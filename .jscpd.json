{
  "format": ["typescript", "html", "scss", "markup"],
  "gitignore": true,
  "ignore": ["**/*.spec.ts", "**/*.mock.ts", "**/spec-utils/**", "**/*.generated.ts"],
  "minLines": 8,
  "minTokens": 60,
  "output": "jscpd-report",
  "path": ["src"],
  "reporters": ["console", "json"],
  "threshold": 1.5
}
