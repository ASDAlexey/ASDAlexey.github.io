{
  "name": "asdalexey-portfolio",
  "version": "1.0.0",
  "description": "Alexey Popov — Tech Lead / Senior Angular Developer. Portfolio site (Angular 22, EN/RU, prerendered, 100% tested).",
  "scripts": {
    "start": "ng serve",
    "start:ru": "ng serve --configuration=ru",
    "build": "ng build --localize",
    "build:gh": "ng build --localize && node scripts/assemble-dist.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "test:watch": "ng test --watch",
    "generate-i18n": "ng extract-i18n --output-path=src/locale --format=xlf",
    "prettier": "prettier -w \"./src/**/**.(html|scss|ts|json)\" --cache",
    "prettier:check": "prettier -c \"./src/**/**.(html|scss|ts|json)\"",
    "eslint": "eslint . --ext .html,.ts",
    "stylelint": "stylelint \"./src/**/**.scss\" --cache --fix",
    "stylelint:check": "stylelint \"./src/**/**.scss\" --cache",
    "jscpd": "jscpd ./src",
    "madge": "bun ./scripts/check-circular-dependencies.js",
    "check:code-quality": "bun run prettier && concurrently --kill-others-on-fail \"bun run eslint\" \"bun run stylelint:check\"",
    "assemble": "node scripts/assemble-dist.mjs",
    "resume": "bash scripts/resume/render.sh",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@prettier/plugin-oxc": "^0.2.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript-eslint/utils": "^8.65.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "8.57.1",
    "eslint-plugin-change-detection-strategy": "^0.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-local-rules": "file:./eslint-local-plugin",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "pretty-quick": "^4.2.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "vitest-auto-spy": "^1.9.2"
  }
}
